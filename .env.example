# Copy to .env for local-only settings. Never commit real secrets.

TELEGRAM_NOTIFY_ENABLED=false
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
# Use @public_channel_username for public channels, or the -100... numeric id for private channels.
# Private channel display names and invite links are not valid Telegram chat_id values.
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id

# Future provider keys. Keep empty until the related integration exists.
OPENAI_API_KEY=
MOOMOO_API_KEY=

# Local Moomoo OpenD connection. Start and log into OpenD before live report runs.
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
MOOMOO_DEFAULT_SYMBOL=US.TSM

# Optional TradingAgents adapter. Disabled by default and kept research-only.
TRADINGAGENTS_ENABLED=false
TRADINGAGENTS_REF=refs/tags/v0.2.4
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_LLM_BACKEND=api
TRADINGAGENTS_CODEX_MODEL=gpt-5.4
TRADINGAGENTS_CODEX_PROFILE=
TRADINGAGENTS_RESULTS_DIR=data/tradingagents/results
TRADINGAGENTS_CACHE_DIR=data/tradingagents/cache
TRADINGAGENTS_MEMORY_DIR=data/tradingagents/memory
TRADINGAGENTS_ALLOW_EXECUTION=false
