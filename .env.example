# Copy to .env for local-only settings. Never commit real secrets.

TELEGRAM_NOTIFY_ENABLED=false
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
# Use @public_channel_username for public channels, or the -100... numeric id for private channels.
# Private channel display names and invite links are not valid Telegram chat_id values.
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id

# Future provider keys. Keep empty until the related integration exists.
OPENAI_API_KEY=
MOOMOO_API_KEY=
OPENROUTER_API_KEY=
NOTION_API_TOKEN=
NOTION_TRADE_JOURNAL_DATABASE_ID=
NOTION_TEMPLATE_PAGE_ID=
NOTION_SYNC_ENABLED=false
NOTION_SYNC_DRY_RUN=true

# Local Moomoo OpenD connection. Start and log into OpenD before live report runs.
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
MOOMOO_DEFAULT_SYMBOL=US.TSM

# Safety default: avoid invoking the installed Google Chrome app for HTML->PDF
# unless you explicitly opt in. Weekly HTML packet/screen flows fall back to the
# native PDF renderer when this is false.
QRD_ENABLE_SYSTEM_CHROME_PDF=false

# Optional TradingAgents adapter. Disabled by default and kept research-only.
TRADINGAGENTS_ENABLED=false
TRADINGAGENTS_REF=refs/tags/v0.2.4
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_LLM_BACKEND=api
TRADINGAGENTS_CODEX_MODEL=gpt-5.4
TRADINGAGENTS_CODEX_PROFILE=
TRADINGAGENTS_RESULTS_DIR=data/tradingagents/results
TRADINGAGENTS_CACHE_DIR=data/tradingagents/cache
TRADINGAGENTS_MEMORY_DIR=data/tradingagents/memory
TRADINGAGENTS_SOURCE_DIR=../TradingAgents
TRADINGAGENTS_ALLOW_EXECUTION=false

# Optional Abacus routing for the standalone TradingAgents fork.
ABACUS_API_KEY=
ABACUS_BASE_URL=https://routellm.abacus.ai/v1
ABACUS_DEEP_MODEL=gpt-5.4
ABACUS_QUICK_MODEL=gpt-5.4-mini
ABACUS_AGENT_MODEL_MAP={"market":"gpt-5.4-mini","social":"gpt-5.4-mini","news":"gpt-5.4-mini","fundamentals":"gpt-5.4-mini","risk_reflection":"gpt-5.4-mini","bull_researcher":"gpt-5.4","bear_researcher":"gpt-5.4","research_manager":"gpt-5.4","trader":"gpt-5.4","portfolio_manager":"gpt-5.4"}

# Optional weekly packet Agent Review. Disabled by default and non-blocking when unavailable.
WEEKLY_AGENT_REVIEW_ENABLED=false
WEEKLY_AGENT_REVIEW_PROVIDER=openrouter
WEEKLY_AGENT_REVIEW_BASE_URL=https://openrouter.ai/api/v1
WEEKLY_AGENT_REVIEW_MODEL=deepseek/deepseek-v4-flash
WEEKLY_AGENT_REVIEW_FALLBACK_MODEL=tencent/hy3-preview
WEEKLY_AGENT_REVIEW_TIMEOUT_SECONDS=90
WEEKLY_AGENT_REVIEW_MAX_TOKENS=1800
WEEKLY_AGENT_REVIEW_TEMPERATURE=0.2

# Weekly stock-first screen defaults.
WEEKLY_ANALYSIS_MODE=stock-first
WEEKLY_MAX_UNDERLYINGS=60
WEEKLY_STOCK_REVIEW_ENABLED=true
WEEKLY_STOCK_REVIEW_MODEL=gpt-5.5
WEEKLY_OPTION_AGENT_REVIEW_ENABLED=false
WEEKLY_OPTION_AGENT_REVIEW_MODEL=gpt-5.5
WEEKLY_OPTION_AGENT_REVIEW_TOP_K=5
WEEKLY_OPTION_AGENT_REVIEW_CONCURRENCY=3
WEEKLY_OPTION_AGENT_REVIEW_TIMEOUT_SECONDS=120
