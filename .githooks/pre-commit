#!/usr/bin/env sh
set -eu

python_bin="${PYTHON_BIN:-}"
if [ -z "$python_bin" ]; then
  if command -v python3.12 >/dev/null 2>&1; then
    python_bin="python3.12"
  elif command -v python3.11 >/dev/null 2>&1; then
    python_bin="python3.11"
  else
    python_bin="python3"
  fi
fi

if ! "$python_bin" scripts/preflight.py --hook pre-commit; then
  "$python_bin" scripts/telegram_notify.py --post "pre-commit preflight failed in Quant Researcher Desk" || true
  exit 1
fi
